# Copy to .env for local work, against a local MongoDB. Keep production
# credentials in a separate gitignored file such as .env.prod and select it
# explicitly: NEWS_ENV_FILE=.env.prod make seed
# Never commit .env or paste credentials into chat.
NEWS_MONGO_URI=mongodb://localhost:27017
NEWS_MONGO_DATABASE=news

# Optional shared key for the private Python recommender and Go reader.
# NEWS_RECOMMENDER_API_KEY=
