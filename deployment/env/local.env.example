# Settings for running news-bot on your own computer (a laptop).
#
# How to use this file:
#   - The easy way: run ./run.sh. When deployment/env/local.env does not exist yet,
#     run.sh copies this file to local.env and fills in the empty keys below with
#     new random values. It never prints them.
#   - By hand: copy this file to deployment/env/local.env (the same folder) and fill
#     in every empty key. Make each key with:   openssl rand -hex 32
#
# local.env is private. Git ignores it. Never commit it, paste it into a chat or
# share it. This example file holds no secrets and is safe to commit.
#
# The programs also read local.env when you run them from the repository without
# Docker (for example `make -C ml demo-serve`). NEWS_ENV_FILE=<path> picks another file.
#
# Write one KEY=value per line, with no spaces around "=", and no comment after a
# value on the same line.

# --- Keys that the services share ---------------------------------------------------
# run.sh fills each empty one. To make one yourself: openssl rand -hex 32

# The collector sends this key to the classifier (topic sorting).
NEWS_CLASSIFIER_API_KEY=
# The web app and the MCP program send this key to the ranker.
NEWS_RECOMMENDER_API_KEY=
# Key for the collector's own API (/api/v1/...). Send it in the X-API-Key header.
# You may list several keys, separated by commas. Each needs 32 or more characters.
NEWS_AUTH_API_KEYS=

# --- The MCP program for AI agents (optional: ./run.sh --mcp) -----------------------
# LOCAL_MCP_AGENT_KEY is the key you give to your AI agent. NEWS_MCP_API_KEYS keeps
# only its SHA-256 fingerprint, as "name:fingerprint". run.sh makes both. By hand:
#   python3 -c "import secrets,hashlib; k=secrets.token_urlsafe(32); print('LOCAL_MCP_AGENT_KEY=' + k); print('NEWS_MCP_API_KEYS=local:' + hashlib.sha256(k.encode()).hexdigest())"
LOCAL_MCP_AGENT_KEY=
NEWS_MCP_API_KEYS=
# Requests a minute for each agent key.
NEWS_MCP_RATE_LIMIT=60

# --- The database -------------------------------------------------------------------
# Leave NEWS_MONGO_URI empty to start a new, empty MongoDB inside Docker (the normal
# choice). The collector then fills it with news.
#
# To use a MongoDB that already runs on this computer instead (for example one from
# Homebrew), write its address as this computer sees it, for example:
#   NEWS_MONGO_URI=mongodb://127.0.0.1:27017/
# The collector writes new articles into it. run.sh refuses a MongoDB on another
# computer unless you add --allow-remote-mongo. It cannot see through an SSH tunnel,
# so never point this at a tunnel to a server you do not want to change.
NEWS_MONGO_URI=
# The database name inside MongoDB.
NEWS_MONGO_DATABASE=news
# Only for a MongoDB that is not in Docker, and only when run.sh's guess is wrong:
# the address as the containers see it (see deployment/compose/compose.external-mongo.yaml).
NEWS_EXTERNAL_MONGO_URI=

# --- Ports on this computer -----------------------------------------------------------
# Every port listens on 127.0.0.1 only. If another program already uses one, run.sh
# stops and tells you; then pick a free number here, for example 18090.
LOCAL_PORT_WEB=8090
LOCAL_PORT_MCP=8091
LOCAL_PORT_COLLECTOR=8080
LOCAL_PORT_CLASSIFIER=8000
LOCAL_PORT_RANKER=8001
LOCAL_PORT_MONGO=27017

# --- Collector ------------------------------------------------------------------------
# true: read the news feeds all the time. false: start without collecting.
NEWS_SCHEDULER_ENABLED=true
# How often to look for feeds that are due.
NEWS_SCHEDULER_INTERVAL=60s

# --- Ranker snapshot ------------------------------------------------------------------
# run.sh waits for this many articles before it builds the first snapshot.
LOCAL_MIN_ARTICLES=500
# Leave empty to use the newest snapshot (ml/artifacts/recommender/LATEST_DEMO).
NEWS_RANKER_SNAPSHOT=

# --- Logs -----------------------------------------------------------------------------
# Level: debug, info, warn or error. Format: text (easy to read) or json.
NEWS_LOGGING_LEVEL=info
NEWS_LOGGING_FORMAT=text

# --- Memory for the Docker MongoDB --------------------------------------------------
# Its cache in GB, and its memory limit. Production uses 2 and 3g (roadmap C15).
LOCAL_MONGO_CACHE_GB=1
LOCAL_MONGO_MEMORY=2g
