# Secret settings for the home server: Kubernetes (k3s) with the Helm chart in
# deployment/helm/news-bot.
#
# How to use this file:
#   1. Copy it to deployment/env/home.env (the same folder). Git ignores home.env.
#   2. Fill in every value. Make each password and key with:   openssl rand -hex 32
#      Every MongoDB password must be different from the others.
#   3. Make the Kubernetes Secret from it (the chart reads only this Secret):
#        kubectl create namespace news-bot
#        kubectl -n news-bot create secret generic news-bot-env --from-env-file=deployment/env/home.env
#   4. To change a value later, edit home.env and run:
#        kubectl -n news-bot create secret generic news-bot-env --from-env-file=deployment/env/home.env \
#          --dry-run=client -o yaml | kubectl apply -f -
#      then restart the app: kubectl -n news-bot rollout restart deployment
#
# Never commit home.env, paste it into a chat or print it. Settings that are not
# secret (web address, image tags, memory) live in values-home.yaml instead.
#
# Write one KEY=value per line. Do not put quotes around values: kubectl keeps them.

# --- MongoDB --------------------------------------------------------------------------
# The administrator ("root") login of the MongoDB that the chart starts. It is set
# only when the database is created for the first time.
NEWS_MONGO_ROOT_USERNAME=root
NEWS_MONGO_ROOT_PASSWORD=
# One login per part of the app (deployment/mongo/mongo-users.js makes them).
# Each must be exactly 64 characters from 0-9 and a-f: openssl rand -hex 32
NEWS_MONGO_COLLECTOR_PASSWORD=
NEWS_MONGO_BATCH_PASSWORD=
NEWS_MONGO_RANKER_PASSWORD=
NEWS_MONGO_READER_PASSWORD=
NEWS_MONGO_OWNER_PASSWORD=
NEWS_MONGO_MCP_PASSWORD=

# --- Keys that the services share -----------------------------------------------------
# The collector sends this key to the classifier.
NEWS_CLASSIFIER_API_KEY=
# The web app and the MCP program send this key to the ranker.
NEWS_RECOMMENDER_API_KEY=

# --- The collector's own API (/api/v1/...) -------------------------------------------
# One or more keys, separated by commas; each 32 characters or more.
NEWS_AUTH_API_KEYS=
# Optional: a user name and password (16 characters or more) for the same API.
NEWS_AUTH_BASIC_USERNAME=
NEWS_AUTH_BASIC_PASSWORD=

# --- Google sign-in for the reader app ------------------------------------------------
# From Google Cloud Console: an OAuth client of type "Web application" whose
# redirect URI is <web.publicUrl>/auth/callback (see server/README.md).
NEWS_GOOGLE_CLIENT_ID=
NEWS_GOOGLE_CLIENT_SECRET=

# --- The MCP program for AI agents ----------------------------------------------------
# "name:sha256(key)" pairs, separated by commas. Make one with:
#   python3 -c "import secrets,hashlib; k=secrets.token_urlsafe(32); print('agent key:', k); print('entry: claude:' + hashlib.sha256(k.encode()).hexdigest())"
# Give the agent key to the agent; put only the entry here.
NEWS_MCP_API_KEYS=

# --- Cloudflare Tunnel ----------------------------------------------------------------
# The token of a tunnel made in the Cloudflare Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > cloudflared). Leave empty if you do not use it.
NEWS_CLOUDFLARE_TUNNEL_TOKEN=

# --- Model download -------------------------------------------------------------------
# A GitHub token that can read the private repository mhd-riaz/news-bot-archive.
# The classifier downloads its model with it the first time it starts. A
# fine-grained token with "Contents: read" on that one repository is enough.
GITHUB_TOKEN=

# --- Only for the "readers" command on your own computer ------------------------------
# No pod reads these. They let you invite readers through a port-forward:
#   kubectl -n news-bot port-forward svc/news-bot-mongo 27018:27017
#   cd server && NEWS_ENV_FILE=../deployment/env/home.env uv run newsbot-server readers list
# Put the owner password from above in place of <owner-password>.
NEWS_OWNER_MONGO_URI=mongodb://owner:<owner-password>@127.0.0.1:27018/?authSource=news
NEWS_MONGO_DATABASE=news
